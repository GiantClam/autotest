{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GiantClam/autotest/delivery-case.schema.json",
  "type": "object",
  "required": ["schemaVersion", "workItemId", "project", "repository", "targetSha", "branch", "lifecycleStages", "statuses"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workItemId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$" },
    "project": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "targetSha": { "type": "string", "minLength": 7 },
    "branch": { "type": "string", "minLength": 1 },
    "environment": { "type": "object" },
    "policy": { "type": "object" },
    "lifecycleStages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "statuses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "createdAt": { "type": "string" }
  },
  "additionalProperties": false
}
